# Copy this file to .env.local and fill in your real Supabase project values.
# Find these in your Supabase dashboard: Project Settings -> API.

# Project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key (Settings -> API -> Project API keys -> anon public)
# Safe to expose in the browser; Row Level Security policies protect your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary (server-only — used to upload user profile images).
# Find these in your Cloudinary dashboard: https://console.cloudinary.com -> Settings -> API Keys.
# Never prefix these with NEXT_PUBLIC_: the API secret must stay server-side.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
